name: lab4
mgmt:
    network: mgmt-net
    ipv4-subnet: 192.168.100.0/24
topology:
    kinds:
        vr-ros:
            image: vrnetlab/vr-routeros:6.47.9
            binds:
              - scripts/setup_ssh.sh:/tmp/setup_ssh.sh
            exec:
              - sh /tmp/setup_ssh.sh
            group: router
        linux:
            image: alpine:3.20.0
            binds:
              - scripts/setup_pc.sh:/tmp/setup.sh
            exec:
              - sh /tmp/setup.sh
            group: leaf
    nodes:
        R01.SPB:
            kind: vr-ros
            mgmt-ipv4: 192.168.100.2
            startup-config: configs/part1/R01.SPB
        R01.HKI:
            kind: vr-ros
            mgmt-ipv4: 192.168.100.3
            startup-config: configs/part1/R01.HKI
        R01.LBN:
            kind: vr-ros
            mgmt-ipv4: 192.168.100.4
            startup-config: configs/part1/R01.LBN
        R01.SVL:
            kind: vr-ros
            mgmt-ipv4: 192.168.100.5
            startup-config: configs/part1/R01.SVL
        R01.LND:
            kind: vr-ros
            mgmt-ipv4: 192.168.100.6
            startup-config: configs/part1/R01.LND
        R01.NY:
            kind: vr-ros
            mgmt-ipv4: 192.168.100.7
            startup-config: configs/part1/R01.NY
        PC1:
            kind: linux
            stages:
              create:
                wait-for:
                  - node: R01.SPB
                    stage: configure
        PC2:
            kind: linux
            stages:
              create:
                wait-for:
                  - node: R01.NY
                    stage: configure
        PC3:
            kind: linux
            stages:
              create:
                wait-for:
                  - node: R01.SVL
                    stage: configure

    links:
        - endpoints: ["R01.NY:eth2", "PC2:eth2"]
        - endpoints: ["R01.NY:eth3", "R01.LND:eth2"]
        - endpoints: ["R01.LND:eth3", "R01.LBN:eth2"]
        - endpoints: ["R01.LND:eth4", "R01.HKI:eth2"]
        - endpoints: ["R01.HKI:eth3", "R01.LBN:eth3"]
        - endpoints: ["R01.LBN:eth4", "R01.SVL:eth2"]
        - endpoints: ["R01.SVL:eth3", "PC3:eth2"]
        - endpoints: ["R01.HKI:eth4", "R01.SPB:eth2"]
        - endpoints: ["R01.SPB:eth3", "PC1:eth2"]
